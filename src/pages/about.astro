---
import Layout from '../layouts/Layout.astro';
import { experience, education, skills, spoken } from '../data/about';
import { getProject } from '../data/projects';
import { site, url } from '../data/site';
---

<Layout title="About" description="About Shubham Chandok — experience, education, and skills.">
  <div class="wrap">
    <header class="hero">
      <div class="prompt"><span class="g">$</span> whoami</div>
      <h1>{site.name}</h1>
      <div class="lead">
        <p>
          I'm a full stack developer. I build <b>web platforms, content systems, and Flutter apps</b> for
          real businesses — HR, billing, libraries, events, and manufacturing.
        </p>
        <p>
          In my current role I've shipped an HRMS with face-recognition attendance, a billing and collection
          platform, and a corporate portal with a headless CMS. On my own time I build offline-first mobile apps;
          my Android launcher passed 100K downloads.
        </p>
      </div>
      <p class="comment"><span class="a">//</span> speaks {spoken.join(' & ').toLowerCase()}</p>
    </header>

    <section>
      <div class="sec-head"><span class="g">$</span> git log --oneline</div>
      <div class="log">
        {
          experience.map((e) => (
            <div class="entry">
              <span class="hash">{e.hash}</span>
              <div>
                <div class="role">{e.role}</div>
                <div class="co">{e.company}</div>
                <div class="links">
                  {e.projects.map((slug) => {
                    const p = getProject(slug);
                    return p ? <a href={url(`/work/${p.slug}`)}>{p.title}</a> : null;
                  })}
                </div>
                {e.note && <p class="note">{e.note}</p>}
              </div>
              <span class="when">{e.when}</span>
            </div>
          ))
        }
      </div>
    </section>

    <section>
      <div class="sec-head"><span class="g">$</span> cat ./education</div>
      <div class="log">
        <div class="entry">
          <span class="hash">mca</span>
          <div>
            <div class="role">{education.degree}</div>
            <div class="co">{education.school} — {education.score}</div>
          </div>
          <span class="when">{education.when}</span>
        </div>
      </div>
    </section>

    <section>
      <div class="sec-head"><span class="g">$</span> cat ./skills</div>
      <div class="skills">
        {
          skills.map((s) => (
            <div class="row">
              <div class="label">{s.h}</div>
              <div class="items">{s.items.join(' · ')}</div>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</Layout>
