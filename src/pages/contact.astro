---
import Layout from '../layouts/Layout.astro';
import ContactList from '../components/ContactList.astro';
import { site } from '../data/site';
---

<Layout title="Contact" description="Contact Shubham Chandok by email.">
  <div class="wrap">
    <header class="hero">
      <div class="prompt"><span class="g">$</span> contact --shubham</div>
      <h1 class="cta-title">Building something? Let's talk.</h1>
      <div class="lead">
        <p>I'm open to full-time roles, freelance work, and collaborations. Email is the fastest way to reach me.</p>
      </div>
      <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
    </header>

    <section>
      <div class="sec-head"><span class="a">//</span> all channels</div>
      <ContactList />
    </section>
  </div>
</Layout>
