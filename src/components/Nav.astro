---
import { site, url } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Astro.url.pathname may include the base; strip it so active checks stay simple.
const raw = Astro.url.pathname.replace(/\/+$/, '') || '/';
const pathname = base && raw.startsWith(base) ? raw.slice(base.length) || '/' : raw;
const nav = site.nav.map((item) => ({ ...item, href: url(item.href) }));

function isActive(href: string): boolean {
  const path = href.split('#')[0].replace(/\/+$/, '') || '/';
  if (path === '/') return pathname === '/' || pathname.startsWith('/work');
  return pathname === path;
}
---

<nav class="nav" data-base={base} transition:persist="site-nav" aria-label="Primary">
  <a class="brand" href={url('/')}><span class="g tilde">~/</span>shubham<span class="m">@</span>chandok</a>
  <div class="navlinks">
    {
      nav.map((item, i) => (
        <Fragment>
          {i > 0 && <span class="sep" aria-hidden="true">·</span>}
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        </Fragment>
      ))
    }
    <ThemeToggle />
  </div>
</nav>

<script>
  // The nav persists across navigations, so update the active link manually.
  if (!window.__navBound) {
    window.__navBound = true;
    document.addEventListener('astro:page-load', () => {
      const navEl = document.querySelector('.nav');
      const base = navEl?.getAttribute('data-base') || '';
      const raw = window.location.pathname;
      const pathname = (base && raw.startsWith(base) ? raw.slice(base.length) : raw).replace(/\/+$/, '') || '/';
      document.querySelectorAll('.navlinks a').forEach((a) => {
        const href = (a.getAttribute('href') || '').replace(base, '');
        const path = href.split('#')[0].replace(/\/+$/, '') || '/';
        const active = path === '/' ? pathname === '/' || pathname.startsWith('/work') : pathname === path;
        if (active) a.setAttribute('aria-current', 'page');
        else a.removeAttribute('aria-current');
      });
    });
  }
</script>
