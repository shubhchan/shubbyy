---
---

<div class="cat" data-cat data-base={import.meta.env.BASE_URL} aria-hidden="true"></div>

<script>
  import type { AnimationItem, LottiePlayer } from 'lottie-web';

  // Both cat files share the same rig and geometry (composition units).
  // The pupils live on their own layers and move inside the irises.
  const COMP_WIDTH = 1440;
  const EYES_CENTER = { x: 709, y: 2428 }; // midpoint between both irises
  const PARENT_SCALE = 1.83; // scale of the parent null layer
  const RADIUS = 15; // max pupil travel from the iris center (layer units)
  // Pupil rest position relative to its iris center, at the last frame.
  const REST = { l: { x: 10.6, y: -1.1 }, r: { x: -7.4, y: 1.1 } };

  type Vec = { x: number; y: number };
  type Eye = { el: SVGGElement; rest: Vec; cur: Vec };

  const STATIC =
    '<svg class="cat-static" viewBox="0 0 190 170" xmlns="http://www.w3.org/2000/svg">' +
    '<path class="cat-body" d="M42 66 L27 14 L78 42 Z"/>' +
    '<path class="cat-body" d="M148 66 L163 14 L112 42 Z"/>' +
    '<ellipse class="cat-body" cx="95" cy="102" rx="61" ry="55"/>' +
    '<circle class="cat-iris" cx="69" cy="98" r="12"/>' +
    '<circle class="cat-iris" cx="121" cy="98" r="12"/>' +
    '<circle class="cat-pupil" cx="69" cy="98" r="7"/>' +
    '<circle class="cat-pupil" cx="121" cy="98" r="7"/>' +
    '<path class="cat-nose" d="M95 114 l-6 6 h12 Z"/></svg>';

  let lottie: LottiePlayer | null = null;
  let anim: AnimationItem | null = null;
  let animPath = '';
  let base = '/';
  let mounted = false;
  let cat: HTMLElement | null = null;
  let eyes: Eye[] = [];
  let raf = 0;
  const pointer = { x: 0, y: 0, active: false };
  let scrollVelocity = 0;
  let lastScrollY = window.scrollY;

  function reduced(): boolean {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function themePath(): string {
    const file = document.documentElement.getAttribute('data-theme') === 'light' ? 'cat-light.json' : 'cat-dark.json';
    return `${base}${file}`;
  }

  function clampLength(v: Vec, max: number): Vec {
    const len = Math.hypot(v.x, v.y);
    return len > max ? { x: (v.x / len) * max, y: (v.y / len) * max } : v;
  }

  // Where the pupils should look, in layer units relative to the iris center.
  function lookTarget(): Vec {
    let target: Vec = { x: 0, y: 0 };
    if (cat && pointer.active) {
      const rect = cat.getBoundingClientRect();
      const s = rect.width / COMP_WIDTH;
      const dx = pointer.x - (rect.left + EYES_CENTER.x * s);
      const dy = pointer.y - (rect.top + EYES_CENTER.y * s);
      const dist = Math.hypot(dx, dy);
      if (dist > 1) {
        const m = (RADIUS * dist) / (dist + 140);
        target = { x: (dx / dist) * m, y: (dy / dist) * m };
      }
    }
    // Scrolling down makes the cat glance down; scrolling up glances up.
    target.y += Math.max(-RADIUS, Math.min(RADIUS, scrollVelocity * 0.5));
    return clampLength(target, RADIUS);
  }

  function tick() {
    raf = 0;
    if (!eyes.length) return;
    const target = lookTarget();
    scrollVelocity *= 0.85;
    let moving = Math.abs(scrollVelocity) > 0.05;
    for (const eye of eyes) {
      eye.cur.x += (target.x - eye.cur.x) * 0.18;
      eye.cur.y += (target.y - eye.cur.y) * 0.18;
      if (Math.abs(target.x - eye.cur.x) > 0.02 || Math.abs(target.y - eye.cur.y) > 0.02) moving = true;
      const tx = (eye.cur.x - eye.rest.x) * PARENT_SCALE;
      const ty = (eye.cur.y - eye.rest.y) * PARENT_SCALE;
      eye.el.style.translate = `${tx.toFixed(2)}px ${ty.toFixed(2)}px`;
    }
    if (moving) kick();
  }

  function kick() {
    if (!raf && eyes.length) raf = requestAnimationFrame(tick);
  }

  function startTracking(container: HTMLElement, from?: Eye[]) {
    const l = container.querySelector<SVGGElement>('.cat-eye-l');
    const r = container.querySelector<SVGGElement>('.cat-eye-r');
    if (!l || !r) return;
    eyes = [
      { el: l, rest: REST.l, cur: { ...(from?.[0]?.cur ?? REST.l) } },
      { el: r, rest: REST.r, cur: { ...(from?.[1]?.cur ?? REST.r) } }
    ];
    tick();
  }

  // Load the cat for the current theme. When `revealed` is true, skip the peek
  // and show the final pose (used when the theme changes on the same page).
  function load(el: HTMLElement, revealed: boolean) {
    if (!lottie) return;
    const previousEyes = eyes;
    eyes = [];
    anim?.destroy();
    el.innerHTML = '';
    animPath = themePath();
    const a = lottie.loadAnimation({
      container: el,
      renderer: 'svg',
      rendererSettings: { preserveAspectRatio: 'xMidYMax meet' },
      loop: false,
      autoplay: !revealed,
      path: animPath
    });
    anim = a;
    if (revealed) {
      a.addEventListener('DOMLoaded', () => {
        a.goToAndStop(a.totalFrames - 1, true);
        startTracking(el, previousEyes);
      });
    } else {
      // Let the peek finish, then hand the pupils to the pointer.
      a.addEventListener('complete', () => startTracking(el));
    }
  }

  async function mount(el: HTMLElement) {
    if (mounted) return;
    mounted = true;
    cat = el;
    base = el.dataset.base || '/';
    if (!base.endsWith('/')) base += '/';
    if (reduced()) {
      el.innerHTML = STATIC;
      return;
    }
    lottie ??= (await import('lottie-web/build/player/lottie_light')).default;
    if (cat !== el) return; // navigated away while loading
    load(el, false);
    // Warm the cache so a theme switch swaps cats without a gap.
    const other = animPath.endsWith('cat-light.json') ? 'cat-dark.json' : 'cat-light.json';
    fetch(`${base}${other}`).catch(() => {});
  }

  function destroy() {
    if (raf) cancelAnimationFrame(raf);
    raf = 0;
    eyes = [];
    anim?.destroy();
    anim = null;
    animPath = '';
    cat = null;
    mounted = false;
  }

  function init() {
    const el = document.querySelector<HTMLElement>('[data-cat]');
    if (el) mount(el);
  }

  if (!window.__catBound) {
    window.__catBound = true;
    window.addEventListener(
      'pointermove',
      (e) => {
        pointer.x = e.clientX;
        pointer.y = e.clientY;
        pointer.active = true;
        kick();
      },
      { passive: true }
    );
    document.documentElement.addEventListener('pointerleave', () => {
      pointer.active = false;
      kick();
    });
    window.addEventListener(
      'scroll',
      () => {
        const y = window.scrollY;
        scrollVelocity = Math.max(-40, Math.min(40, y - lastScrollY));
        lastScrollY = y;
        kick();
      },
      { passive: true }
    );
    // Swap to the other cat when the theme changes.
    new MutationObserver(() => {
      if (cat && anim && themePath() !== animPath) load(cat, true);
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    document.addEventListener('astro:page-load', init);
    document.addEventListener('astro:before-swap', destroy);
  }
  init();
</script>
